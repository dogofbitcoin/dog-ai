# DotSwap on chain source (Nexus node)
NEXUS_URL=http://18.208.62.248:17610
NEXUS_API_KEY=
POOL_TICK1=DOG•GO•TO•THE•MOON
POOL_TICK1_COIN_TYPE=runes
POOL_TICK2=BTC
POOL_TICK2_COIN_TYPE=btc
# Cache TTL in seconds for DotSwap fetches. Set to 0 to disable.
DOTSWAP_CACHE_TTL=60

# Kraken provider (read only in v0.1)
KRAKEN_CLI_PATH=kraken
KRAKEN_PAIR=DOGBTC

# Indicators
VWAP_WINDOW_SECONDS=300

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Optional: enables LLM narration for agent reasoning lines.
# If absent, agents fall back to rule based reasoning.
ANTHROPIC_API_KEY=

# Frontend dev server (set in the frontend env, not the backend)
VITE_API_BASE=http://localhost:8000
